## https://www.doxygen.nl/manual/config.html

PROJECT_NAME = "@PROJECT_NAME@"
PROJECT_NUMBER = @PROJECT_VERSION@
OUTPUT_DIRECTORY = @DOXYGEN_OUTPUT_DIR@
INPUT = README.md \
        @CMAKE_CURRENT_SOURCE_DIR@/nlgenerator \
        @CMAKE_CURRENT_SOURCE_DIR@/nlgeometry \
        @CMAKE_CURRENT_SOURCE_DIR@/nlphysics \
        @CMAKE_CURRENT_SOURCE_DIR@/nlrender
RECURSIVE = YES
FULL_PATH_NAMES = NO
USE_MDFILE_AS_MAINPAGE = README.md